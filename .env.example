NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
GEMINI_API_KEY=your_default_gemini_api_key
# Server-side only. Used to encrypt per-user Gemini keys before storing in DB.
USER_API_KEY_ENCRYPTION_KEY=replace_with_a_long_random_secret
# Debug endpoint guard (optional, default: disabled)
ENABLE_MODEL_DEBUG_ENDPOINT=false
# Optional comma-separated user ids allowed to access /api/test-models in non-production.
DEBUG_MODEL_ALLOWED_USER_IDS=
